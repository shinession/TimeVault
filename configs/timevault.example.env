# TimeVault settings (template).
#
# Copy this file to ".env" next to timevault-server.exe (or into the folder you start it from),
# replace every <placeholder> and remove the lines you do not need. The service reads the file
# itself when it starts. A setting that is also present in the process environment wins over
# this file. TIMEVAULT_ENV_FILE=<path> names another file; it must exist.
# Never commit a filled-in copy: it holds passwords. See docs/runbook.md.
#
# The monitored folders and their schedules are NOT set here. An administrator manages them on
# the Settings page of the web UI and they are stored in the database.

# --- Listener ---------------------------------------------------------------
# Loopback by default. Anyone who can reach this address can browse the backed-up files, and the
# user accounts' passwords are sent to it: put a TLS reverse proxy in front before other
# computers use it.
TIMEVAULT_LISTEN_ADDR=127.0.0.1:8660
# Only when listening on a non-loopback address that a TLS reverse proxy protects.
# TIMEVAULT_ALLOW_NON_LOOPBACK=true
# Set to true when the site is served over HTTPS.
TIMEVAULT_COOKIE_SECURE=false

# --- PostgreSQL -------------------------------------------------------------
TIMEVAULT_DATABASE_URL=postgres://timevault:<password>@127.0.0.1:5432/<database>
# true applies migrations at start; otherwise run "timevault-server migrate" first.
TIMEVAULT_AUTO_MIGRATE=false

# --- Storage ----------------------------------------------------------------
# Backup folder (the repository): separate from every monitored folder, empty or already a
# TimeVault repository. Changing it needs a restart.
TIMEVAULT_REPOSITORY_PATH=<path-to-backup-folder>
# Restores create new folders below this one. Empty disables restore.
# It must not be inside or contain the repository or a monitored folder.
TIMEVAULT_RESTORE_ROOT=<path-to-restore-folder>

# --- Sign-in ----------------------------------------------------------------
# Anyone can browse without signing in. Backing up, restoring, the audit log and the settings
# need an account.
#
# Company accounts are read from Redis (the app_user_* hashes). Check the connection with:
#   timevault-server check-redis-users
# redis://[:password]@host:port/db  (rediss:// for TLS). The account's Type "admin" may change
# the monitored folders; every other active account may back up and restore.
TIMEVAULT_REDIS_URL=redis://:<password>@127.0.0.1:6379/0
# TIMEVAULT_REDIS_KEY_PREFIX=app_user_
# TIMEVAULT_REDIS_TIMEOUT=3s
#
# Optional local administrator who can still sign in when Redis is down. Leave both lines out for none.
# TIMEVAULT_ADMIN_USER=admin
# Output of: timevault-server hash-password
# TIMEVAULT_ADMIN_PASSWORD_HASH=<hash-from-hash-password>
#
# Base64 text that decodes to at least 32 random bytes; keeps sessions across restarts.
TIMEVAULT_SESSION_KEY=<base64-of-32-or-more-random-bytes>
TIMEVAULT_SESSION_TTL=8h

# --- Search (optional) ------------------------------------------------------
# Everything HTTP server on this computer. Leave empty to turn search off.
# TIMEVAULT_EVERYTHING_URL=http://127.0.0.1:<port>/
# TIMEVAULT_EVERYTHING_USERNAME=<username>
# TIMEVAULT_EVERYTHING_PASSWORD=<password>
# TIMEVAULT_EVERYTHING_TIMEOUT=5s

# --- Performance and logging ------------------------------------------------
TIMEVAULT_JOB_WORKERS=2
# TIMEVAULT_HASH_WORKERS=4
TIMEVAULT_LOG_LEVEL=info
TIMEVAULT_LOG_FORMAT=text
