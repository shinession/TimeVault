# TimeVault server settings (template). Copy it, replace every <placeholder>, and load it
# into the service's environment. Never commit a filled-in copy. See docs/runbook.md.

# --- Listener ---------------------------------------------------------------
# Loopback by default. Put a TLS reverse proxy in front for other computers.
TIMEVAULT_LISTEN_ADDR=127.0.0.1:8470
# Only when listening on a non-loopback address that a TLS reverse proxy protects.
# TIMEVAULT_ALLOW_NON_LOOPBACK=true
# Set to true when the site is served over HTTPS.
TIMEVAULT_COOKIE_SECURE=false

# --- PostgreSQL -------------------------------------------------------------
TIMEVAULT_DATABASE_URL=postgres://timevault:<password>@127.0.0.1:5432/timevault
# true applies migrations at start; otherwise run "timevault-server migrate" first.
TIMEVAULT_AUTO_MIGRATE=false

# --- Storage ----------------------------------------------------------------
# Repository folder: separate from every source, empty or already a TimeVault repository.
TIMEVAULT_REPOSITORY_PATH=<path-to-repository-folder>
# Restores create new folders below this one. Empty disables restore.
# It must not be inside or contain the repository or a source.
TIMEVAULT_RESTORE_ROOT=<path-to-restore-folder>

# --- Sign-in ----------------------------------------------------------------
TIMEVAULT_ADMIN_USER=admin
# Output of: timevault-server hash-password
TIMEVAULT_ADMIN_PASSWORD_HASH=<hash-from-hash-password>
# Base64 text that decodes to at least 32 random bytes; keeps sessions across restarts.
TIMEVAULT_SESSION_KEY=<base64-of-32-or-more-random-bytes>
TIMEVAULT_SESSION_TTL=8h

# --- Search (optional) ------------------------------------------------------
# Everything HTTP server on this computer. Leave empty to turn search off.
# TIMEVAULT_EVERYTHING_URL=http://127.0.0.1:<port>/
# TIMEVAULT_EVERYTHING_USERNAME=<username>
# TIMEVAULT_EVERYTHING_PASSWORD=<password>
# TIMEVAULT_EVERYTHING_TIMEOUT=5s

# --- Performance and logging ------------------------------------------------
TIMEVAULT_JOB_WORKERS=2
# TIMEVAULT_HASH_WORKERS=4
TIMEVAULT_LOG_LEVEL=info
TIMEVAULT_LOG_FORMAT=text
